# ============================================
# Configuratix configuration
# ============================================
# Copy to .env. Used by `docker compose` (production) and by the Taskfile (local dev).

# ============================================
# DATABASE (external Postgres; migrations run automatically on backend start)
# ============================================
# Running in Docker and Postgres is on the same host? Use host.docker.internal instead
# of localhost/127.0.0.1 (localhost inside a container is the container itself).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/configuratix?sslmode=disable

# Signs login tokens. Keep it stable or every restart logs everyone out. 32+ characters.
JWT_SECRET=your-super-secret-jwt-key-change-me

# Optional migration tuning for slow/flaky DB connections
MIGRATION_TIMEOUT_SECONDS=180
MIGRATION_RETRY_DELAY_MS=1000

# Domain health check interval (hours)
# CHECK_INTERVAL_HOURS=1

# ============================================
# HOST PORTS (docker compose)
# ============================================
# Single-origin gateway: UI + API + websockets + install.sh on one port.
# Point your reverse proxy here; that's all it needs.
APP_PORT=8000

# Backend and UI published directly as well, on the same ports as the pre-Docker setup,
# so existing agents and existing proxy rules keep working unchanged during migration.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Address the ports bind to on the host. 127.0.0.1 = reachable only by a proxy on this host.
# Keep 0.0.0.0 if agents talk to http://<server-ip>:BACKEND_PORT directly.
# Note: Docker-published ports bypass ufw.
BIND_ADDR=0.0.0.0

# Max upload size through the gateway (static site uploads)
GATEWAY_MAX_BODY_SIZE=512m

# Where landing uploads/previews live on the host (existing data is used in place)
# DATA_DIR=./backend/data

# ============================================
# BACKEND URL SEEN BY THE BROWSER (read at runtime, no rebuild)
# ============================================
# Leave empty for single-origin (UI and API behind the same host, via APP_PORT).
# Set it when the API lives on its own domain/port, e.g. https://api.yourdomain.com.
# Also used for the agent install one-liner shown in the UI.
PUBLIC_API_URL=

# Legacy/dev: if PUBLIC_API_URL is empty, docker falls back to this (so pre-Docker .env files
# keep their split UI/API setup as-is). For local `task dev` it is the dev API URL.
# NEXT_PUBLIC_API_URL=http://localhost:8080
